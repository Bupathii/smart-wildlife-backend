# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/wildlife-conservation

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS - comma separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# File uploads (local storage for prototype)
UPLOAD_DIR=uploads

# Frontend URL (used to build password reset links)
CLIENT_URL=http://localhost:5173

# Email (nodemailer) - used for "Forgot Password" emails.
# If left blank, reset links are printed to the server console instead of emailed (useful for local dev).
# Example values for Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_SECURE=false,
# EMAIL_USER=you@gmail.com, EMAIL_PASS=<Gmail App Password, not your normal password>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Wildlife Conservation <no-reply@wildlife.test>"
